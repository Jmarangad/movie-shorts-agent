# --- API credentials -----------------------------------------------------
# YouTube Data API v3 key (Module 1: movie search)
YOUTUBE_API_KEY=

# LLM provider: "gemini", "openai", "deepseek", "opencode" or "ollama" (Module 2)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=big-pickle
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4-flash:0731

# --- TTS (Module 3) -------------------------------------------------------
TTS_VOICE=hi-IN-SwaraNeural
TTS_RATE=+0%

# --- Story plan (Module 2) -------------------------------------------------
TARGET_SCRIPT_WORDS=220
MAX_SCENES=6
MIN_SCENE_SECONDS=5
MAX_SCENE_SECONDS=12
MAX_TRANSCRIPT_CHARS=250000

# --- Download / edit (Modules 4-5) -----------------------------------------
TARGET_DURATION_SECONDS=120
OUTPUT_DIR=output
DOWNLOADS_DIR=downloads
KEEP_CLIPS=false
MAX_DOWNLOAD_RETRIES=3
# Drop downloaded clips that are still photos / title cards (no motion).
# Score is the mean frame-to-frame difference (0..255); lower = more static.
MIN_CLIP_MOTION=2.5

# --- Captions (Module 5) ---------------------------------------------------
HINDI_FONT=/usr/share/fonts/truetype/lohit-devanagari/Lohit-Devanagari.ttf
CAPTION_FONT_SIZE=52
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
OUTPUT_FPS=24

# --- Search: only English thriller / horror / romantic / survival movies (Module 1) --
GENRES=thriller,horror,romantic,survival
SEARCH_LANGUAGE=en

# --- Used-movie tracking (new movie on every run, Module 6) ------------------
USED_MOVIES_PATH=output/used_movies.json

# --- Output backup: copy each run's files to a timestamped folder ------------
# and delete backups older than this many hours (latest outputs stay in place).
BACKUP_DIR=output/backups
BACKUP_RETENTION_HOURS=48

# --- Scheduler (Module 6) ----------------------------------------------------
SCHEDULE_INTERVAL_HOURS=3